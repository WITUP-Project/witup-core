<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Loggers>
        <Logger name="sootup" level="warn" additivity="false"/>
        <Logger name="org.sootup" level="warn" additivity="false"/>

        <Root level="error">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%msg%n"/>
        </Console>
    </Appenders>
</Configuration>